{%- comment -%}
  Flowers Vasette: delivery / collection date picker for the cart page, as a section of its own (for themes whose
  cart is several sections, like Dawn). Horizon and other block-based themes: use blocks/vasette-delivery-date.liquid
  instead, to place it inside the Cart section next to the checkout button. See README.md.
{%- endcomment -%}
{%- render 'vasette-delivery-date', section_id: section.id, required: section.settings.require, heading: section.settings.heading, class: 'page-width', attributes: '' -%}

{% schema %}
{
  "name": "Delivery date",
  "tag": "section",
  "class": "section-vasette-delivery-date",
  "enabled_on": { "templates": ["cart"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Delivery or collection" },
    { "type": "checkbox", "id": "require", "label": "A date is needed before checkout", "default": true }
  ],
  "presets": [{ "name": "Delivery date" }]
}
{% endschema %}
